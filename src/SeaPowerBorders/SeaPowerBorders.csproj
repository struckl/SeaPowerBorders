<Project Sdk="Microsoft.NET.Sdk">

  <!--The common part (framework, game references, the flat-map build with -p:GameBuild=Flat, deploy, the shared source files)
      comes from the R.A.T.S. Core repo: SeaPowerCore\Rats.Mod.props in the workspace.
      -p:RatsWorkspace=<workspace> builds from a clone outside it, -p:RatsCore=<folder>\ against another copy of the Core repo.-->
  <PropertyGroup>
    <AssemblyName>SeaPowerBorders</AssemblyName>
    <RootNamespace>SeaPowerBorders</RootNamespace>
    <Product>National borders on Sea Power's tactical map.</Product>
    <Version>1.2.0</Version>
    <RatsUseLayers>true</RatsUseLayers>
    <RatsWorkspace Condition="'$(RatsWorkspace)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildProjectDirectory), mods.json))</RatsWorkspace>
    <RatsCore Condition="'$(RatsCore)' == ''">$([MSBuild]::EnsureTrailingSlash('$(RatsWorkspace)'))SeaPowerCore\</RatsCore>
  </PropertyGroup>

  <Import Project="$(RatsCore)Rats.Mod.props" />

  <ItemGroup>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CommunityToolkit.Mvvm"><HintPath>$(ManagedDir)\CommunityToolkit.Mvvm.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedDir)\Unity.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><HintPath>$(ManagedDir)\Unity.Collections.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
