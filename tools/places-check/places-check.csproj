<Project Sdk="Microsoft.NET.Sdk">
  <!-- Offline check of the place lists and borders: the mod's Places and Borders code against the game's campaign files. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SeaPowerBorders</RootNamespace>
  </PropertyGroup>
  <!-- The mod's plain C# parts (no game types): GameMarkers reads the running mission, so it stays out. -->
  <ItemGroup>
    <Compile Include="..\..\src\SeaPowerBorders\Places\*.cs" Exclude="..\..\src\SeaPowerBorders\Places\GameMarkers.cs" />
    <Compile Include="..\..\src\SeaPowerBorders\Map\LabelPicker.cs" />
    <Compile Include="..\..\src\SeaPowerBorders\Map\LabelLook.cs" />
    <Compile Include="..\..\src\SeaPowerBorders\Borders\*.cs" />
    <Compile Include="..\..\src\SeaPowerBorders\DataFiles.cs" />
    <Compile Include="..\..\src\SeaPowerBorders\Choices.cs" />
  </ItemGroup>
</Project>
